filters:
  and:
    - categories.contains("Planos de Refeicoes")
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Nome
  note.author:
    displayName: Autor
  note.type:
    displayName: Tipo
  note.ingredients:
    displayName: Ingredientes
  note.cuisine:
    displayName: Cozinha
  note.rating:
    displayName: Avaliação
views:
  - type: table
    name: Planos
    order:
      - file.name
      - type
      - cuisine
      - author
      - ingredients
      - rating
    columnSize:
      note.type: 201
      note.cuisine: 174
