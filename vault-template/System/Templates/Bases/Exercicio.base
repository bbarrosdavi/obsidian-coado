filters:
  and:
    - note.categories.contains("Exercicio")
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Nome
  note.type:
    displayName: Tipo
  note.target:
    displayName: Alvo Muscles
  note.equipment:
    displayName: Equipment
  note.duration:
    displayName: Duration (min)
  note.sets:
    displayName: Sets
  note.reps:
    displayName: Reps
  note.rating:
    displayName: Avaliação
  note.last:
    displayName: Last Done
views:
  - type: table
    name: Todos os Exercícios
    order:
      - file.name
      - type
      - target
      - equipment
      - sets
      - reps
      - rating
      - last
    sort:
      - property: last
        direction: DESC
    columnSize:
      note.type: 120
      note.target: 180
      note.equipment: 150
  - type: table
    name: Por Tipo
    order:
      - type
      - file.name
      - target
      - equipment
      - duration
    sort:
      - property: type
        direction: ASC
  - type: table
    name: Por Músculo Alvo
    order:
      - target
      - file.name
      - type
      - sets
      - reps
    sort:
      - property: target
        direction: ASC
