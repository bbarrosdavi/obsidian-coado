# Copie para .env e preencha. O mesmo arquivo serve ao Docker Compose e ao `npm run dev`.

# ---------- Docker Compose ----------
# Porta e endereço públicos do app (sem barra no final). Use https em produção.
COADO_PORT=8080
PUBLIC_URL=http://localhost:8080
# produção: PUBLIC_URL=https://coado.app.br

# Banco. Use só letras e números na senha (ela entra numa URL de conexão).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo que assina o cookie temporário do login (mínimo 32 caracteres).
#   openssl rand -hex 32
SESSION_SECRET=

# Login com Google: https://console.cloud.google.com/apis/credentials
# Crie um "ID do cliente OAuth" do tipo Aplicativo da Web e cadastre como URI de redirecionamento:
#   ${PUBLIC_URL}/api/auth/google/callback             (ex.: http://localhost:8080/api/auth/google/callback)
#   http://localhost:5173/api/auth/google/callback     (desenvolvimento com npm run dev)
# Para o app Android, crie também um cliente do tipo Android (pacote br.app.coado + SHA-1 da assinatura);
# o app usa este mesmo client id web para pedir o id_token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Arquivos dos usuários
UPLOAD_MAX_FILE_MB=25
UPLOAD_QUOTA_MB=500

# ---------- Desenvolvimento (npm run dev) ----------
# A api local lê este .env; o banco vem de `npm run db:up`.
DATABASE_URL=postgres://coado:TROQUE_PELA_POSTGRES_PASSWORD@localhost:5432/coado
# Botão "Entrar como visitante" sem Google. Nunca funciona com NODE_ENV=production.
AUTH_DEV_LOGIN=true
