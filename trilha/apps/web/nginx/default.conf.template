# Servidor do front: entrega o SPA e encaminha /api para o container da api.
# Template processado pelo entrypoint da imagem oficial do nginx (envsubst de ${API_UPSTREAM}).

# esquema original quando há outro proxy com TLS na frente
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # uploads de até 25 MB + folga do multipart
    client_max_body_size 26m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # DNS interno do Docker: reavalia o ip da api se o container for recriado
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # envia uploads direto, sem gravar em disco no nginx
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # rotas do React Router
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
